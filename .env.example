# ============================================================
# 智慧园区专家问答策略系统 - 本地部署环境变量示例
# 复制本文件为 .env.local，并填入你的真实配置
#   cp .env.example .env.local
# ============================================================

# ---- PostgreSQL 数据库 (必需) ----
DATABASE_URL=postgresql://localhost:5432/expert_qa

# ---- AI 能力 (可选，用于"随身专家对话"的 RAG 与流式 LLM) ----
# 不使用 AI 对话时可不填，其余功能不受影响
COZE_API_TOKEN=your_coze_api_token

# ---- 端口 (可选，默认 3000) ----
# PORT=3000