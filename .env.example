# ============================================================
# 智慧园区专家问答策略系统 - 本地部署环境变量示例
# 复制本文件为 .env.local，并填入你的真实配置
#   cp .env.example .env.local
# ============================================================

# ---- Supabase (必需) ----
# 在 Supabase 控制台 Project Settings -> API 获取
# URL 形如: https://xxxx.supabase.co
COZE_SUPABASE_URL=your_supabase_url
# anon / public 密钥
COZE_SUPABASE_ANON_KEY=your_supabase_anon_key
# service_role 密钥（仅后端使用，切勿暴露给前端）
COZE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- AI 能力 (可选，用于"随身专家对话"的 RAG 与流式 LLM) ----
# 不使用 AI 对话时可不填，其余功能不受影响
COZE_API_TOKEN=your_coze_api_token

# ---- 端口 (可选，默认 3000) ----
# PORT=3000